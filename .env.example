# MySQL 8.0.16+ (8.4 recommended). XAMPP/MariaDB also supports the schema.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campuscanva_db
PORT=5000
UPLOAD_DIR=server/uploads
# mysql is the default; mock is an explicit frontend-only practice fallback.
VITE_DATA_MODE=mysql
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000
